PORT=3000
NODE_ENV=development
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/campuseats?retryWrites=true&w=majority
JWT_ACCESS_SECRET=your_super_secret_access_key_min_32_characters_long_for_security
JWT_REFRESH_SECRET=your_super_secret_refresh_key_min_32_characters_long_for_security
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
