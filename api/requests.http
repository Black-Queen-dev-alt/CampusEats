# VS Code REST Client - CampusEats API Test Suite

### Global variables
@baseUrl = http://localhost:3000

### 1. Healthcheck
GET {{baseUrl}}/health

### 2. Register Student (Public)
# @name registerStudent
POST {{baseUrl}}/auth/register
Content-Type: application/json

{
  "email": "etudiant.test@univ-campus.fr",
  "password": "Password123!",
  "fullName": "Thomas Dubois",
  "phone": "0601020304"
}

### 3. Login Student
# @name loginStudent
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "etudiant.test@univ-campus.fr",
  "password": "Password123!"
}

### Extract tokens from login response
@accessToken = {{loginStudent.response.body.data.accessToken}}
@refreshToken = {{loginStudent.response.body.data.refreshToken}}

### 4. List Time Slots (obtenir un ID valide)
# @name listTimeSlots
GET {{baseUrl}}/time-slots
Authorization: Bearer {{accessToken}}

@someTimeSlotId = {{listTimeSlots.response.body[0]._id}}

### 5. Get Student Profile (/me) - Authenticated
GET {{baseUrl}}/me
Authorization: Bearer {{accessToken}}

### 6. Update Student Profile (/me)
PATCH {{baseUrl}}/me
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "fullName": "Thomas D. Modifié",
  "phone": "0699887766"
}

### 7. Refresh Token
# @name refreshTokenRequest
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}

### Extract new access token (optionnel)
@accessToken = {{refreshTokenRequest.response.body.data.accessToken}}

### 8. Create Order
# @name createOrder
POST {{baseUrl}}/orders
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "timeSlotId": "{{someTimeSlotId}}",
  "items": [
    { "name": "Pizza Margherita", "quantity": 1 },
    { "name": "Salade César", "quantity": 2 }
  ]
}

### Capture created order ID
@orderId = {{createOrder.response.body._id}}

### 9. List Student Orders
GET {{baseUrl}}/orders
Authorization: Bearer {{accessToken}}

### 10. Cancel Own Order
POST {{baseUrl}}/orders/{{orderId}}/cancel
Authorization: Bearer {{accessToken}}

### 11. List Orders for a Time Slot
GET {{baseUrl}}/time-slots/{{someTimeSlotId}}/orders
Authorization: Bearer {{accessToken}}

### 12. Update Order Status (e.g., mark as "ready")
PATCH {{baseUrl}}/orders/{{orderId}}/status
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "status": "ready"
}

### 13. Register Device (e.g., push notification token)
# @name registerDevice
POST {{baseUrl}}/devices
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "deviceToken": "sample-device-token-123",
  "platform": "android"
}

### 14. Security Test: Student tries to access admin route (expect 403)
POST {{baseUrl}}/admin/users
Authorization: Bearer {{accessToken}}
Content-Type: application/json

{
  "email": "chef.cuisine@univ-campus.fr",
  "password": "ChefPassword123!",
  "fullName": "Chef Pierre",
  "role": "personnel"
}

### 15. Logout (revoke refresh token)
POST {{baseUrl}}/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refreshToken}}"
}
