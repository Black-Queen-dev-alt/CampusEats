# VS Code REST Client — CampusEats API
# Définir une date future et disposer d’un serveur MongoDB seedé.
@baseUrl = http://localhost:3000
@pickupDate = 2026-12-15

### Santé de l’API
GET {{baseUrl}}/health

### Connexion admin
# @name adminLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "admin@campuseats.univ.edu",
  "password": "Admin1234!"
}

@adminAccessToken = {{adminLogin.response.body.data.accessToken}}

### Lister les plats et choisir le premier
# @name listDishes
GET {{baseUrl}}/dishes?page=1&limit=20
Authorization: Bearer {{adminAccessToken}}

@dishId = {{listDishes.response.body.data[0].id}}

### Créer le menu de retrait
# @name createMenu
POST {{baseUrl}}/menus
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "date": "{{pickupDate}}",
  "items": [
    {
      "dishId": "{{dishId}}",
      "isAvailable": true,
      "dailyStockLimit": 50
    }
  ],
  "isPublished": true
}

@menuId = {{createMenu.response.body.data.id}}

### Créer un créneau de retrait
# @name createTimeSlot
POST {{baseUrl}}/time-slots
Authorization: Bearer {{adminAccessToken}}
Content-Type: application/json

{
  "date": "{{pickupDate}}",
  "startTime": "12:00",
  "endTime": "12:15",
  "capacity": 20
}

@slotId = {{createTimeSlot.response.body.data.id}}

### Connexion étudiant
# @name studentLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "student@campuseats.univ.edu",
  "password": "Student1234!"
}

@studentAccessToken = {{studentLogin.response.body.data.accessToken}}
@studentRefreshToken = {{studentLogin.response.body.data.refreshToken}}

### Créer une commande
# @name createOrder
POST {{baseUrl}}/orders
Authorization: Bearer {{studentAccessToken}}
Content-Type: application/json

{
  "menuId": "{{menuId}}",
  "slotId": "{{slotId}}",
  "lines": [
    {
      "dishId": "{{dishId}}",
      "quantity": 1
    }
  ]
}

@orderId = {{createOrder.response.body.data.id}}

### Consulter son historique paginé
GET {{baseUrl}}/orders?page=1&limit=20
Authorization: Bearer {{studentAccessToken}}

### Annuler sa commande avant le début du créneau
POST {{baseUrl}}/orders/{{orderId}}/cancel
Authorization: Bearer {{studentAccessToken}}

### Reconnexion personnel
# @name staffLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "email": "staff@campuseats.univ.edu",
  "password": "Staff1234!"
}

@staffAccessToken = {{staffLogin.response.body.data.accessToken}}

### Consulter les commandes du créneau
GET {{baseUrl}}/time-slots/{{slotId}}/orders?page=1&limit=20
Authorization: Bearer {{staffAccessToken}}

### Enregistrer le jeton FCM de l’étudiant
POST {{baseUrl}}/devices
Authorization: Bearer {{studentAccessToken}}
Content-Type: application/json

{
  "fcmToken": "remplacer-par-un-jeton-fcm-reel"
}

### Rotation du refresh token étudiant
# @name refreshStudent
POST {{baseUrl}}/auth/refresh
Content-Type: application/json

{
  "refreshToken": "{{studentRefreshToken}}"
}

### Déconnexion et révocation du refresh token renouvelé
POST {{baseUrl}}/auth/logout
Content-Type: application/json

{
  "refreshToken": "{{refreshStudent.response.body.data.refreshToken}}"
}
